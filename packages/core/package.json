{
  "name": "@siws/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Core library for Sign In With Solana",
  "author": "osiws contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osiws/siws.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/osiws/siws/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/osiws/siws/issues"
  },
  "keywords": [
    "solana",
    "authentication",
    "sign-in",
    "siws",
    "wallet",
    "web3",
    "ed25519",
    "signature",
    "blockchain"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "bs58": "^6.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
