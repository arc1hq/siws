{
  "name": "@siws/better-auth",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Sign In With Solana plugin for better-auth",
  "author": "osiws contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osiws/siws.git",
    "directory": "packages/better-auth"
  },
  "homepage": "https://github.com/osiws/siws/tree/main/packages/better-auth#readme",
  "bugs": {
    "url": "https://github.com/osiws/siws/issues"
  },
  "keywords": [
    "solana",
    "authentication",
    "sign-in",
    "siws",
    "wallet",
    "web3",
    "better-auth",
    "plugin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "better-auth": ">=1.0.0"
  },
  "dependencies": {
    "@siws/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@siws/eslint-config": "workspace:*",
    "@siws/typescript-config": "workspace:*",
    "better-auth": "^1.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}